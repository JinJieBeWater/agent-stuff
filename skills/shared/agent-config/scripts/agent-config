#!/usr/bin/env python3
"""Keep every agent host on this machine wired to ~/.agents/skills.

  agent-config check              report drift; exit 1 if anything needs attention
  agent-config apply              fix what this script owns, report the rest
  agent-config apply --dry-run    print what apply would change

Manifest: ~/.config/agent-config/skills.toml (names are directory names in ~/.agents/skills)

  explicit_only = ["mole"]        # hide from the model in addition to SKILL.md frontmatter
  [exclude]
  pi = ["show-me"]                # keep a skill out of one host

Output: one line per finding, `TAG host name  detail`. Tags: MISSING, STALE, FOREIGN,
BROKEN, POLICY, EXCLUDE, PROMPT (drift) and INFO, WARN (no exit code effect). apply prefixes
fixed lines with FIXED, dry-run with WOULD. Start a new host session to see changes.
"""
import json
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
REPO = Path(__file__).resolve().parents[4]  # pi-stuff: skills/shared/agent-config/scripts/agent-config
AGENTS = HOME / ".agents/skills"
MANIFEST = HOME / ".config/agent-config/skills.toml"
LINK_HOSTS = {"claude": HOME / ".claude/skills", "antigravity": HOME / ".gemini/config/skills"}
CODEX = HOME / ".codex/skills"
CLAUDE_SETTINGS = HOME / ".claude/settings.json"
CLAUDE_HIDE = "user-invocable-only"
PI_SETTINGS = HOME / ".pi/agent/settings.json"
SHARED_AGENTS = REPO / "config/shared/AGENTS.md"
# (host, entry, target, fixable): apply creates a missing link; it never replaces an existing file.
PROMPT_LINKS = [
    ("agents", HOME / ".agents/AGENTS.md", SHARED_AGENTS, True),
    ("codex", HOME / ".codex/AGENTS.md", HOME / ".agents/AGENTS.md", True),
    ("pi", HOME / ".pi/agent/AGENTS.md", SHARED_AGENTS, True),
    ("pi", HOME / ".pi/agent/APPEND_SYSTEM.md", REPO / "config/pi/APPEND_SYSTEM.md", True),
    ("antigravity", HOME / ".gemini/config/AGENTS.md", SHARED_AGENTS, False),
    ("antigravity", HOME / ".gemini/GEMINI.md", REPO / "config/antigravity/GEMINI.md", False),
]
CLAUDE_MD = HOME / ".claude/CLAUDE.md"
CLAUDE_IMPORT = "@~/.agents/AGENTS.md"
MARK = "# codex-skill-policy"  # kept from the old codex-skill-policy script so its edits stay ours
YAML_HEADER = f"{MARK}: managed file\n"
YAML_LINE = f"  allow_implicit_invocation: false  {MARK}\n"
HOSTS = ("claude", "codex", "pi", "antigravity")


class Report:
    def __init__(self, mode):
        self.mode = mode  # check | apply | dry
        self.drift = 0

    def finding(self, tag, host, name, detail="", fix=None):
        """Drift. `fix` runs under apply; without one the finding needs a human."""
        self.drift += 1
        line = f"{tag} {host} {name}" + (f"  {detail}" if detail else "")
        if fix and self.mode == "apply":
            fix()
            line = "FIXED " + line
        elif fix and self.mode == "dry":
            line = "WOULD " + line
        print(line)

    def note(self, tag, host, name, detail=""):
        print(f"{tag} {host} {name}" + (f"  {detail}" if detail else ""))


def load_manifest():
    """The manifest is required: without it apply would undo every exception it holds."""
    if not MANIFEST.exists():
        sys.exit(f"{MANIFEST} not found: restore it, or create an empty file to mean no exceptions")
    data = tomllib.loads(MANIFEST.read_text())

    def names(value, key):
        if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
            sys.exit(f"{MANIFEST}: {key} must be a list of names")
        return value

    unknown = set(data) - {"explicit_only", "exclude"}
    if unknown:
        sys.exit(f"{MANIFEST}: unknown key: {', '.join(sorted(unknown))}")
    exclude = data.get("exclude", {})
    unknown = set(exclude) - set(HOSTS) if isinstance(exclude, dict) else {"exclude must be a table"}
    if unknown:
        sys.exit(f"{MANIFEST}: unknown host in [exclude]: {', '.join(sorted(unknown))}")
    return {
        "explicit_only": names(data.get("explicit_only", []), "explicit_only"),
        "exclude": {h: set(names(exclude.get(h, []), f"exclude.{h}")) for h in HOSTS},
    }


def agents_skills():
    """name -> realpath for every entry of ~/.agents/skills, None when broken."""
    out = {}
    if AGENTS.is_dir():
        for p in sorted(AGENTS.iterdir()):
            if p.name.startswith("."):
                continue
            out[p.name] = os.path.realpath(p) if (p / "SKILL.md").is_file() else None
    return out


def raw_target(link):
    return os.path.normpath(os.path.join(os.path.dirname(link), os.readlink(link)))


def correct(link, skills):
    """The host entry resolves to the same directory as ~/.agents/skills/<its name>."""
    real = skills.get(link.name)
    return link.is_symlink() and real is not None and os.path.realpath(link) == real


def dangling_into_agents(link):
    """A link left behind after its ~/.agents/skills entry was removed."""
    return link.is_symlink() and not link.exists() and raw_target(link).startswith(str(AGENTS) + os.sep)


def check_links(rep, man, skills):
    for name, real in skills.items():
        if real is None:
            rep.finding("BROKEN", "agents", name, f"-> {os.readlink(AGENTS / name)}" if (AGENTS / name).is_symlink() else "no SKILL.md")
    live = {n for n, r in skills.items() if r is not None}
    for host, root in LINK_HOSTS.items():
        for name in sorted(live):
            p = root / name
            want = name not in man["exclude"][host]
            if correct(p, skills):
                if not want:
                    rep.finding("STALE", host, name, "excluded in manifest", p.unlink)
            elif p.is_symlink() or p.exists():
                if want:
                    rep.finding("FOREIGN", host, name, f"{'-> ' + os.readlink(p) if p.is_symlink() else 'real directory' if p.is_dir() else 'regular file'}; not touched")
            elif want:
                rel = os.path.relpath(AGENTS / name, root)
                rep.finding("MISSING", host, name, "", lambda p=p, rel=rel: (root.mkdir(parents=True, exist_ok=True), p.symlink_to(rel)))
        if root.is_dir():
            for p in sorted(root.iterdir()):
                if p.name not in skills and dangling_into_agents(p):
                    rep.finding("STALE", host, p.name, "gone from ~/.agents/skills", p.unlink)
    if CODEX.is_dir():
        for p in sorted(CODEX.iterdir()):
            if correct(p, skills) or dangling_into_agents(p):
                rep.finding("STALE", "codex", p.name, "Codex reads ~/.agents/skills itself", p.unlink)


def frontmatter_hidden(skill_dir):
    text = (Path(skill_dir) / "SKILL.md").read_text(errors="replace")
    m = re.search(r"^---\s*\n(.*?)\n---", text, re.S)
    return bool(m and re.search(r"^disable-model-invocation:\s*true\s*$", m.group(1), re.M))


YAML_MANUAL = object()  # the file's policy: line is not a plain block; a human edits it
POLICY_BLOCK = re.compile(r"^policy:[ \t]*(#.*)?$")


def yaml_wanted(cur, hide):
    """The openai.yaml text we want given the current text (None = absent); "" = delete."""
    if cur is None:
        return YAML_HEADER + "policy:\n" + YAML_LINE if hide else None
    if cur.startswith(YAML_HEADER):
        return cur if hide else ""
    lines = [l for l in cur.splitlines(keepends=True) if not l.rstrip("\n").endswith(MARK)]
    base = "".join(lines)
    if not hide:
        base = re.sub(rf"^#(\s+allow_implicit_invocation:.*?)  {MARK}-orig$", r"\1", base, flags=re.M)
        return re.sub(r"^policy:[ \t]*\n(?![ \t]+\S)", "", base, flags=re.M)
    if re.search(r"^\s+allow_implicit_invocation:\s*false\b", base, re.M):
        return base
    if any(l.startswith("policy:") and not POLICY_BLOCK.match(l.rstrip("\n")) for l in lines):
        return YAML_MANUAL
    out, done = [], False
    for l in lines:
        if re.match(r"^\s+allow_implicit_invocation:", l):
            l = "#" + l.rstrip("\n") + f"  {MARK}-orig\n"
        out.append(l)
        if not done and POLICY_BLOCK.match(l.rstrip("\n")):
            out.append(YAML_LINE)
            done = True
    text = "".join(out)
    if not done:
        text = text.rstrip("\n") + ("\n" if text.strip() else "") + "policy:\n" + YAML_LINE
    return text


def git_exclude(path):
    """Keep a written openai.yaml out of `git status` in an upstream checkout."""
    d = str(path.parent)
    top = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode:
        return
    if subprocess.run(["git", "-C", d, "ls-files", "--error-unmatch", str(path)], capture_output=True).returncode == 0:
        return
    ex = subprocess.run(["git", "-C", d, "rev-parse", "--git-path", "info/exclude"], capture_output=True, text=True).stdout.strip()
    ex = Path(ex) if os.path.isabs(ex) else Path(d) / ex
    rel = "/" + os.path.relpath(path, top.stdout.strip())
    cur = ex.read_text() if ex.exists() else ""
    if rel not in cur.splitlines():
        ex.parent.mkdir(parents=True, exist_ok=True)
        ex.write_text(cur + ("" if cur.endswith("\n") or not cur else "\n") + rel + "\n")


def write_yaml(path, text):
    if text == "":
        path.unlink()
        try:
            path.parent.rmdir()
        except OSError:
            pass
        return
    path.parent.mkdir(exist_ok=True)
    path.write_text(text)
    git_exclude(path)


def read_json(path):
    return json.loads(path.read_text()) if path.exists() else {}


def write_json(path, data):
    """Two-space JSON; keeps the file's trailing-newline choice (Pi writes none)."""
    nl = "\n" if not path.exists() or path.read_text().endswith("\n") else ""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + nl)


def check_policy(rep, man, skills):
    manifest = man["explicit_only"]
    # Codex's own ~/.codex/skills/.system is left out: Codex rewrites it on every launch.
    live = {n: Path(r) for n, r in skills.items() if r is not None}
    for name in manifest:
        if name not in live:
            rep.note("WARN", "manifest", name, "explicit_only name not found in ~/.agents/skills")

    # Claude: skillOverrides keys are directory names; only ~/.agents names are ours.
    settings = read_json(CLAUDE_SETTINGS)
    ov = settings.get("skillOverrides", {})
    for name in sorted(live):
        want = name in manifest and name not in man["exclude"]["claude"]
        if want and name not in ov:
            rep.finding("POLICY", "claude", name, f'skillOverrides -> "{CLAUDE_HIDE}"', lambda n=name: edit_overrides(n, CLAUDE_HIDE))
        elif not want and ov.get(name) == CLAUDE_HIDE:
            rep.finding("POLICY", "claude", name, "skillOverrides entry no longer in manifest", lambda n=name: edit_overrides(n, None))

    # Codex: agents/openai.yaml inside each skill dir.
    for name, d in sorted(live.items()):
        hide = name in manifest or frontmatter_hidden(d)
        y = d / "agents/openai.yaml"
        cur = y.read_text() if y.exists() else None
        new = yaml_wanted(cur, hide)
        if new is YAML_MANUAL:
            rep.finding("POLICY", "codex", name, f"policy: in {y} is not a plain block; set allow_implicit_invocation: false by hand")
            continue
        if new == cur or (cur is None and new is None):
            continue
        rep.finding("POLICY", "codex", name, f"{'hide' if hide else 'restore'} in {y}", lambda y=y, new=new: write_yaml(y, new))

    # Pi and Antigravity only read SKILL.md frontmatter.
    for name in manifest:
        if name in live and not frontmatter_hidden(live[name]):
            for host in ("pi", "antigravity"):
                if name not in man["exclude"][host]:
                    rep.note("INFO", host, name, "no host setting hides it; add disable-model-invocation to SKILL.md to hide")


def edit_overrides(name, value):
    settings = read_json(CLAUDE_SETTINGS)
    ov = settings.setdefault("skillOverrides", {})
    if value is None:
        ov.pop(name, None)
    else:
        ov[name] = value
    write_json(CLAUDE_SETTINGS, settings)


def tilde(p):
    s = str(p)
    return "~" + s[len(str(HOME)):] if s.startswith(str(HOME) + os.sep) else s


def check_excludes(rep, man, skills):
    for host, names in man["exclude"].items():
        for name in sorted(names - skills.keys()):
            rep.note("WARN", "manifest", name, f"[exclude].{host} name not found in ~/.agents/skills")
    for name in sorted(man["exclude"]["codex"] & skills.keys()):
        rep.note("INFO", "codex", name, "Codex reads ~/.agents/skills itself; to exclude, add [[skills.config]] to ~/.codex/config.toml by hand")

    # Pi: "-<path>" entries in settings.json "skills" that land under ~/.agents/skills are ours.
    settings = read_json(PI_SETTINGS)
    entries = settings.get("skills", [])

    def owned_name(e):
        if not e.startswith("-"):
            return None
        path = os.path.normpath(os.path.expanduser(e[1:]))
        return Path(path).name if os.path.dirname(path) == str(AGENTS) else None

    have = {owned_name(e) for e in entries} - {None}
    want = man["exclude"]["pi"] & skills.keys()
    if have == want:
        return
    for name in sorted(want - have):
        rep.finding("EXCLUDE", "pi", name, f"add to skills in {tilde(PI_SETTINGS)}", lambda: write_pi(want, owned_name))
    for name in sorted(have - want):
        rep.finding("EXCLUDE", "pi", name, f"remove from skills in {tilde(PI_SETTINGS)}", lambda: write_pi(want, owned_name))


def write_pi(want, owned_name):
    settings = read_json(PI_SETTINGS)
    entries = settings.get("skills", [])
    kept = [e for e in entries if owned_name(e) is None or owned_name(e) in want]
    have = {owned_name(e) for e in kept} - {None}
    settings["skills"] = kept + [f"-{AGENTS / n}" for n in sorted(want - have)]
    write_json(PI_SETTINGS, settings)


def check_prompts(rep):
    for host, entry, target, fixable in PROMPT_LINKS:
        if os.path.realpath(entry) == os.path.realpath(target) and entry.exists():
            continue
        if entry.is_symlink() or entry.exists():
            what = f"-> {os.readlink(entry)}" if entry.is_symlink() else "regular file"
            rep.finding("PROMPT", host, tilde(entry), f"{what}, expected -> {tilde(target)}; not touched")
        elif fixable:
            rep.finding("PROMPT", host, tilde(entry), f"missing, link -> {tilde(target)}",
                        lambda e=entry, t=target: (e.parent.mkdir(parents=True, exist_ok=True), e.symlink_to(t)))
        else:
            rep.finding("PROMPT", host, tilde(entry), f"missing; run {tilde(REPO / 'config/antigravity/sync.sh')}")
    text = CLAUDE_MD.read_text() if CLAUDE_MD.exists() else ""
    if CLAUDE_IMPORT not in text.split():
        rep.finding("PROMPT", "claude", tilde(CLAUDE_MD), f"does not import {CLAUDE_IMPORT}; add that line by hand")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd not in ("check", "apply"):
        sys.exit(__doc__)
    mode = "dry" if cmd == "apply" and "--dry-run" in argv else cmd
    rep = Report(mode)
    man = load_manifest()
    skills = agents_skills()
    check_links(rep, man, skills)
    check_policy(rep, man, skills)
    check_excludes(rep, man, skills)
    check_prompts(rep)
    if mode == "check":
        print("ok" if not rep.drift else f"{rep.drift} finding(s)")
        return 1 if rep.drift else 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
